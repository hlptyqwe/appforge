{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["global", "image", "external", "secrets", "ingress", "egressProxy"],
  "properties": {
    "global": {
      "type": "object",
      "required": ["deploymentMode", "imageRegistry", "publicOrigin"],
      "properties": {
        "deploymentMode": {"enum": ["dedicated", "private", "hybrid"]},
        "imageRegistry": {"type": "string", "minLength": 3},
        "publicOrigin": {"type": "string", "pattern": "^https://"},
        "offline": {"type": "boolean"},
        "imagePullSecrets": {"type": "array"},
        "storageClass": {"type": "string"}
      }
    },
    "image": {
      "type": "object",
      "required": ["tag"],
      "properties": {
        "tag": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([+-][0-9A-Za-z.-]+)?$"},
        "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "replicas": {
      "type": "object",
      "properties": {
        "api": {"type": "integer", "minimum": 2},
        "system": {"type": "integer", "minimum": 2},
        "core": {"type": "integer", "minimum": 2},
        "builder": {"type": "integer", "minimum": 1},
        "builderWorker": {"type": "integer", "minimum": 1},
        "worker": {"type": "integer", "minimum": 1},
        "sourceWorker": {"type": "integer", "minimum": 1},
        "ui": {"type": "integer", "minimum": 2},
        "egressProxy": {"type": "integer", "minimum": 2}
      }
    },
    "external": {
      "type": "object",
      "required": ["etcdEndpoints", "etcdAuthSecret", "runtimeConfigSecret", "migrationSecret"],
      "properties": {
        "etcdEndpoints": {"type": "string", "minLength": 3},
        "etcdAuthSecret": {"type": "string", "minLength": 1},
        "runtimeConfigSecret": {"type": "string", "minLength": 1},
        "migrationSecret": {"type": "string", "minLength": 1}
      }
    },
    "secrets": {
      "type": "object",
      "required": ["localAgentCaSecret", "offlineLicenseSecret", "siemSecret"],
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "offlineLicense": {
      "type": "object",
      "required": ["enabled", "deploymentId", "existingStateClaim"],
      "properties": {
        "enabled": {"const": true},
        "deploymentId": {"type": "string", "minLength": 3},
        "existingStateClaim": {"type": "string", "minLength": 1}
      }
    },
    "ingress": {
      "type": "object",
      "required": ["host", "adminHost", "tlsSecretName"],
      "properties": {
        "enabled": {"type": "boolean"},
        "className": {"type": "string"},
        "host": {"type": "string", "minLength": 3},
        "adminHost": {"type": "string", "minLength": 3},
        "tlsSecretName": {"type": "string", "minLength": 1}
      }
    },
    "networkPolicy": {
      "type": "object",
      "required": ["enabled", "ingressNamespaceLabels", "egressCIDRs", "externalEgressRules"],
      "properties": {
        "enabled": {"type": "boolean"},
        "ingressNamespaceLabels": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": "string", "minLength": 1}
        },
        "egressCIDRs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 3, "maxLength": 49}
        },
        "externalEgressRules": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "component", "cidrs", "ports"],
            "additionalProperties": false,
            "properties": {
              "name": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$", "maxLength": 44},
              "component": {
                "enum": ["api", "system", "core", "builder", "builder-worker", "webhook-worker", "billing-worker", "enterprise-worker", "source-trigger-worker", "admin-ui", "agent-ui", "egress-proxy"]
              },
              "cidrs": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"type": "string", "minLength": 3, "maxLength": 49}
              },
              "ports": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["protocol", "port"],
                  "additionalProperties": false,
                  "properties": {
                    "protocol": {"enum": ["TCP", "UDP"]},
                    "port": {"type": "integer", "minimum": 1, "maximum": 65535}
                  }
                }
              }
            }
          }
        }
      }
    },
    "egressProxy": {
      "type": "object",
      "required": ["enabled", "url", "noProxy", "maximumConnections", "allowlist"],
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "url": {"const": "http://appforge-egress-proxy:3128"},
        "noProxy": {"type": "string", "minLength": 1, "maxLength": 2048},
        "maximumConnections": {"type": "integer", "minimum": 1, "maximum": 10000},
        "allowlist": {
          "type": "array",
          "maxItems": 1024,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^((\\*\\.)?([A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?\\.)*[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?:[0-9]{1,5}|\\[[0-9A-Fa-f:]+\\]:[0-9]{1,5})$"}
        }
      }
    },
    "observability": {
      "type": "object",
      "required": ["prometheus", "metricsPort", "metricsPath", "prometheusNamespaceLabels", "otlpEndpoint", "otlpSampler", "siemWebhook"],
      "additionalProperties": false,
      "properties": {
        "prometheus": {"type": "boolean"},
        "metricsPort": {"type": "integer", "minimum": 1, "maximum": 65535},
        "metricsPath": {"type": "string", "pattern": "^/[^?#\\r\\n]*$"},
        "prometheusNamespaceLabels": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": "string", "minLength": 1}
        },
        "otlpEndpoint": {"type": "string", "pattern": "^$|^https://[^@/?#]+(?::[0-9]+)?(?:/[^?#]*)?$"},
        "otlpSampler": {"type": "number", "minimum": 0, "maximum": 1},
        "siemWebhook": {"type": "string", "pattern": "^https://", "minLength": 9}
      }
    }
  }
}
