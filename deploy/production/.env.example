# AppForge production delivery variables. Copy to .env and replace every CHANGE_ME value.
APPFORGE_DEPLOYMENT_MODE=private
APPFORGE_VERSION=1.2.0
APPFORGE_SCHEMA_VERSION=20260815_113_v7_air_gapped
APPFORGE_MAX_VERSION_SKEW=1
APPFORGE_IMAGE_REGISTRY=registry.example.com/appforge
APPFORGE_PUBLIC_ORIGIN=https://appforge.example.com
# 客户/代理端使用公开 Origin；管理端参考部署使用独立本机端口。
APPFORGE_ADMIN_HTTPS_PORT=8443
APPFORGE_AGENT_HTTPS_PORT=443
APPFORGE_LOCAL_AGENT_GATEWAY_PORT=9443
APPFORGE_BUILDER_CONCURRENCY=2

APPFORGE_MYSQL_DATABASE=appforge
APPFORGE_MYSQL_USER=appforge
APPFORGE_MYSQL_PASSWORD=CHANGE_ME_RANDOM_DATABASE_PASSWORD
APPFORGE_MYSQL_ROOT_PASSWORD=CHANGE_ME_RANDOM_ROOT_PASSWORD
APPFORGE_REDIS_PASSWORD=CHANGE_ME_RANDOM_REDIS_PASSWORD
APPFORGE_MINIO_ACCESS_KEY=CHANGE_ME_RANDOM_MINIO_ACCESS_KEY
APPFORGE_MINIO_SECRET_KEY=CHANGE_ME_RANDOM_MINIO_SECRET_KEY
# 可选异地 MinIO/S3 兼容副本。生产 Endpoint 必须为 HTTPS；凭据应是仅限目标桶的复制账号。
APPFORGE_REPLICA_ENDPOINT=
APPFORGE_REPLICA_ACCESS_KEY=
APPFORGE_REPLICA_SECRET_KEY=
APPFORGE_REPLICA_BUCKET=appforge
APPFORGE_REPLICA_RULE_ID=appforge-dr
APPFORGE_REPLICA_SYNC=false
APPFORGE_INTERNAL_RPC_TOKEN=CHANGE_ME_RANDOM_INTERNAL_RPC_TOKEN
APPFORGE_JWT_ACCESS_SECRET=CHANGE_ME_RANDOM_JWT_SECRET_AT_LEAST_32_BYTES
APPFORGE_SECRET_MASTER_KEY_BASE64=CHANGE_ME_32_BYTE_BASE64_KEY
APPFORGE_BOOTSTRAP_ADMIN_USERNAME=owner
# `htpasswd -bnBC 12 '' 'strong-password' | tr -d ':\n' | base64`
APPFORGE_BOOTSTRAP_PASSWORD_BCRYPT_BASE64=CHANGE_ME_BASE64_BCRYPT_HASH
APPFORGE_STRIPE_SECRET_KEY=
APPFORGE_STRIPE_WEBHOOK_SECRET=

# PEM files are mounted read-only; private keys must be mode 0600.
APPFORGE_TLS_CERT_FILE=./secrets/tls.crt
APPFORGE_TLS_KEY_FILE=./secrets/tls.key
APPFORGE_LOCAL_AGENT_CA_CERT_FILE=./secrets/agent-ca.crt
APPFORGE_LOCAL_AGENT_CA_KEY_FILE=./secrets/agent-ca.key
APPFORGE_LICENSE_FILE=./secrets/appforge-license.json
APPFORGE_LICENSE_PUBLIC_KEY_FILE=./secrets/appforge-license-public.pem
APPFORGE_DEPLOYMENT_ID=CHANGE_ME_STABLE_DEPLOYMENT_ID
# 支持 https://... Webhook 或 syslog+tls://host:6514（RFC5424 + RFC6587）。
APPFORGE_SIEM_ENDPOINT=https://siem.example.com/appforge/audit
# 仅 HTTPS Webhook 必填；Syslog TLS 模式可删除该行。
APPFORGE_SIEM_TOKEN_FILE=./secrets/siem-token
APPFORGE_SIEM_CA_FILE=./secrets/siem-ca.crt
APPFORGE_SIEM_SYSLOG_HOSTNAME=
APPFORGE_SIEM_SYSLOG_APP_NAME=appforge

# 指标只监听容器后端网络；OTLP 留空即不导出 Trace，启用时必须为 HTTPS URL。
APPFORGE_PROMETHEUS_ENABLED=true
APPFORGE_PROMETHEUS_PORT=9101
APPFORGE_PROMETHEUS_PATH=/metrics
APPFORGE_OTLP_ENDPOINT=
APPFORGE_OTLP_SAMPLER=0.1

# 可选受限出口代理。启用后使用 `docker compose --profile egress up -d`；
# 应用容器仍只连接 internal 后端网络，只有 CONNECT-only 代理连接出口网络。
APPFORGE_EGRESS_PROXY_ENABLED=false
APPFORGE_EGRESS_PROXY_URL=
APPFORGE_EGRESS_PROXY_ALLOWLIST_FILE=./secrets/egress-allowlist.txt
APPFORGE_EGRESS_PROXY_MAX_CONNECTIONS=256
APPFORGE_EGRESS_NO_PROXY=localhost,127.0.0.1,mysql,redis,etcd,minio,system-rpc,core-rpc,builder-rpc

# 可选企业 Secret Provider。生产环境使用工作负载身份或只读凭证文件。
APPFORGE_LOCAL_SECRET_ROOT=
APPFORGE_KUBERNETES_SECRET_ROOT=
APPFORGE_VAULT_ADDRESS=
APPFORGE_VAULT_TOKEN_FILE=
APPFORGE_VAULT_NAMESPACE=
APPFORGE_AWS_REGION=
APPFORGE_AWS_SECRETS_MANAGER_ENDPOINT=

APPFORGE_BACKUP_DIR=./backups
APPFORGE_RPO_MINUTES=15
APPFORGE_RTO_MINUTES=120
