	certificateNotAfter int64                          `json:"certificateNotAfter,optional"`
	lastHeartbeatAt     int64                          `json:"lastHeartbeatAt,optional"`
	createTime          int64                          `json:"createTime"`
	updateTime          int64                          `json:"updateTime"`
}

type PlatformLocalAgentResp {
	RespBase
	data PlatformLocalAgent `json:"data"`
}

type PlatformLocalAgentListResp {
	RespBase
	data  []PlatformLocalAgent `json:"data"`
	total int64                `json:"total"`
}

type PlatformLocalAgentRegistrationResp {
	RespBase
	data              PlatformLocalAgent `json:"data"`
	registrationToken string             `json:"registrationToken"`
	expiresAt         int64              `json:"expiresAt"`
}

type CreatePlatformLocalAgentRegistrationReq {
	tenantId           int64                          `json:"tenantId,optional"`
	agentCode          string                         `json:"agentCode"`
	agentName          string                         `json:"agentName"`
	poolCode           string                         `json:"poolCode"`
	artifactMode       int32                          `json:"artifactMode"`
	customerStorageRef string                         `json:"customerStorageRef,optional"`
	allowedAppIds      []int64                        `json:"allowedAppIds"`
	capabilities       []PlatformLocalAgentCapability `json:"capabilities"`
	expiresSeconds     int64                          `json:"expiresSeconds,optional"`
}

type ListPlatformLocalAgentsReq {
	PageReq
	tenantId int64 `form:"tenantId,optional"`
	status   int32 `form:"status,optional"`
}

type PlatformLocalAgentIdReq {
	id       int64 `path:"id"`
	tenantId int64 `json:"tenantId,optional" form:"tenantId,optional"`
}

type DrainPlatformLocalAgentReq {
	id          int64 `path:"id"`
	tenantId    int64 `json:"tenantId,optional"`
	drainStatus int32 `json:"drainStatus"`
}

type RevokePlatformLocalAgentReq {
	id       int64  `path:"id"`
	tenantId int64  `json:"tenantId,optional"`
	reason   string `json:"reason"`
}

@server (
	group: platform_public
)
service admin {
	@handler PlatformChannelDownload
	get /d/:channelCode (PlatformChannelDownloadReq)
}

@server (
	prefix: /api
	group:  platform_public
)
service admin {
	@handler PlatformInstallReport
	post /install/report (PlatformInstallReportReq) returns (RespBase)

	@handler PlatformChannelEvent
	post /channel/event (PlatformChannelEventReq) returns (RespBase)
}

@server (
	prefix:  /admin/core
	group:   platform_private
	jwt:     Jwt
	timeout: 10m
)
service admin {
	@handler InitiatePlatformUpload
	post /uploads/initiate (InitiatePlatformUploadReq) returns (InitiatePlatformUploadResp)

	@handler CompletePlatformUpload
	post /uploads/:id/complete (CompletePlatformUploadReq) returns (CompletePlatformUploadResp)

	@handler GetPlatformStorageDownload
	get /storage/objects/:id/download (PlatformStorageObjectIdReq) returns (PlatformStorageDownloadResp)

	@handler CreatePlatformApplication
	post /applications (CreatePlatformApplicationReq) returns (PlatformApplicationResp)

	@handler GetPlatformApplication
	get /applications/:id (PlatformIdReq) returns (PlatformApplicationResp)

	@handler ListPlatformApplications
	get /applications (ListPlatformApplicationsReq) returns (PlatformApplicationListResp)

	@handler CreatePlatformVersion
	post /versions (CreatePlatformVersionReq) returns (PlatformVersionResp)

	@handler GetPlatformVersion
