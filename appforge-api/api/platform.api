	manifestPatchJson     string `json:"manifestPatchJson,optional"`
	resourcePatchJson     string `json:"resourcePatchJson,optional"`
	extensionFilesJson    string `json:"extensionFilesJson,optional"`
	expectedArtifactsJson string `json:"expectedArtifactsJson,optional"`
}

type PublishPlatformWhiteLabelTemplateReq {
	id       int64 `path:"id"`
	revision int32 `json:"revision"`
}

type ChangePlatformWhiteLabelTemplateStatusReq {
	id     int64 `path:"id"`
	status int32 `json:"status"`
}

type CreatePlatformWhiteLabelProductReq {
	appId               int64  `json:"appId"`
	productCode         string `json:"productCode"`
	productName         string `json:"productName"`
	templateId          int64  `json:"templateId"`
	templateRevision    int32  `json:"templateRevision"`
	brandingProfileId   int64  `json:"brandingProfileId"`
	packageName         string `json:"packageName"`
	signingConfigId     int64  `json:"signingConfigId"`
	parameterValuesJson string `json:"parameterValuesJson,optional"`
}

type UpdatePlatformWhiteLabelProductReq {
	id                  int64  `path:"id"`
	productName         string `json:"productName"`
	brandingProfileId   int64  `json:"brandingProfileId"`
	packageName         string `json:"packageName"`
	signingConfigId     int64  `json:"signingConfigId"`
	parameterValuesJson string `json:"parameterValuesJson,optional"`
	templateId          int64  `json:"templateId"`
	templateRevision    int32  `json:"templateRevision"`
}

type ChangePlatformWhiteLabelProductStatusReq {
	id     int64 `path:"id"`
	status int32 `json:"status"`
}

type CreatePlatformBrandingProfileReq {
	appId                int64  `json:"appId"`
	profileName          string `json:"profileName"`
	appName              string `json:"appName"`
	logoObjectId         int64  `json:"logoObjectId"`
	splashObjectId       int64  `json:"splashObjectId"`
	apiHost              string `json:"apiHost"`
	rewriteMode          int32  `json:"rewriteMode"`
	launcherIconTarget   string `json:"launcherIconTarget,optional"`
	splashResourceTarget string `json:"splashResourceTarget,optional"`
	runtimeConfigJson    string `json:"runtimeConfigJson,optional"`
}

type UpdatePlatformBrandingProfileReq {
	id                   int64  `path:"id"`
	profileName          string `json:"profileName"`
	appName              string `json:"appName"`
	logoObjectId         int64  `json:"logoObjectId"`
	splashObjectId       int64  `json:"splashObjectId"`
	apiHost              string `json:"apiHost"`
	rewriteMode          int32  `json:"rewriteMode"`
	launcherIconTarget   string `json:"launcherIconTarget,optional"`
	splashResourceTarget string `json:"splashResourceTarget,optional"`
	runtimeConfigJson    string `json:"runtimeConfigJson,optional"`
}

type ChangePlatformBrandingProfileStatusReq {
	id     int64 `path:"id"`
	status int32 `json:"status"`
}

type CreatePlatformBrandingPreflightReq {
	id        int64 `path:"id"`
	versionId int64 `json:"versionId"`
}

type PlatformIdReq {
	id int64 `path:"id"`
}

type ListPlatformApplicationsReq {
	PageReq
	keyword string `form:"keyword,optional"`
	status  int32  `form:"status,optional"`
}

type ListPlatformVersionsReq {
	PageReq
	appId  int64 `form:"appId,optional"`
	status int32 `form:"status,optional"`
}

type ListPlatformChannelsReq {
	PageReq
	appId   int64  `form:"appId,optional"`
	keyword string `form:"keyword,optional"`
	status  int32  `form:"status,optional"`
}

type ListPlatformSigningConfigsReq {
	PageReq
	appId  int64 `form:"appId,optional"`
	status int64 `form:"status,optional"`
}

type ListPlatformBuildTasksReq {
	PageReq
	appId     int64 `form:"appId,optional"`
	channelId int64 `form:"channelId,optional"`
	status    int32 `form:"status,optional"`
}

type ListPlatformBrandingProfilesReq {
	PageReq
	appId   int64  `form:"appId,optional"`
	keyword string `form:"keyword,optional"`
	status  int32  `form:"status,optional"`
}

type ListPlatformBrandingPreflightsReq {
	PageReq
	appId             int64 `form:"appId,optional"`
	brandingProfileId int64 `form:"brandingProfileId,optional"`
	versionId         int64 `form:"versionId,optional"`
	status            int32 `form:"status,optional"`
}

type ListPlatformWhiteLabelTemplatesReq {
	PageReq
	appId   int64  `form:"appId,optional"`
	keyword string `form:"keyword,optional"`
	status  int32  `form:"status,optional"`
}

type ListPlatformWhiteLabelTemplateRevisionsReq {
	PageReq
	id     int64 `path:"id"`
	status int32 `form:"status,optional"`
}

type ListPlatformWhiteLabelProductsReq {
	PageReq
	appId   int64  `form:"appId,optional"`
	keyword string `form:"keyword,optional"`
	status  int32  `form:"status,optional"`
}

type PlatformChannelStats {
	channelId     int64  `json:"channelId"`
	channelCode   string `json:"channelCode"`
	clicks        int64  `json:"clicks"`
	downloads     int64  `json:"downloads"`
	installs      int64  `json:"installs"`
	registrations int64  `json:"registrations"`
	firstPays     int64  `json:"firstPays"`
	pays          int64  `json:"pays"`
}

type PlatformChannelStatsResp {
	RespBase
	data PlatformChannelStats `json:"data"`
}

type GetPlatformChannelStatsReq {
	appId     int64 `form:"appId"`
	channelId int64 `form:"channelId"`
	startTime int64 `form:"startTime,optional"`
	endTime   int64 `form:"endTime,optional"`
}

type PlatformInstallReportReq {
	appId         int64  `json:"appId"`
	channelCode   string `json:"channelCode"`
	installId     string `json:"installId"`
	appVersion    string `json:"appVersion,optional"`
	deviceModel   string `json:"deviceModel,optional"`
	ip            string `json:"ip,optional"`
	firstOpenTime int64  `json:"firstOpenTime,optional"`
}

type PlatformChannelEventReq {
	appId       int64  `json:"appId"`
	channelCode string `json:"channelCode"`
	eventType   int32  `json:"eventType"`
	eventKey    string `json:"eventKey"`
	installId   string `json:"installId,optional"`
	userId      int64  `json:"userId,optional"`
	appVersion  string `json:"appVersion,optional"`
	ip          string `json:"ip,optional"`
	deviceModel string `json:"deviceModel,optional"`
	eventTime   int64  `json:"eventTime,optional"`
	metadata    string `json:"metadata,optional"`
}

type PlatformChannelDownloadReq {
	channelCode string `path:"channelCode"`
}

@server (
	group: platform_public
)
service admin {
	@handler PlatformChannelDownload
	get /d/:channelCode (PlatformChannelDownloadReq)
}

@server (
	prefix: /api
	group:  platform_public
)
service admin {
	@handler PlatformInstallReport
	post /install/report (PlatformInstallReportReq) returns (RespBase)

	@handler PlatformChannelEvent
	post /channel/event (PlatformChannelEventReq) returns (RespBase)
}

@server (
	prefix:  /admin/core
	group:   platform_private
	jwt:     Jwt
	timeout: 10m
)
service admin {
	@handler InitiatePlatformUpload
	post /uploads/initiate (InitiatePlatformUploadReq) returns (InitiatePlatformUploadResp)

	@handler CompletePlatformUpload
	post /uploads/:id/complete (CompletePlatformUploadReq) returns (CompletePlatformUploadResp)

	@handler GetPlatformStorageDownload
	get /storage/objects/:id/download (PlatformStorageObjectIdReq) returns (PlatformStorageDownloadResp)

	@handler CreatePlatformApplication
	post /applications (CreatePlatformApplicationReq) returns (PlatformApplicationResp)

	@handler GetPlatformApplication
	get /applications/:id (PlatformIdReq) returns (PlatformApplicationResp)

	@handler ListPlatformApplications
	get /applications (ListPlatformApplicationsReq) returns (PlatformApplicationListResp)

	@handler CreatePlatformVersion
	post /versions (CreatePlatformVersionReq) returns (PlatformVersionResp)

	@handler GetPlatformVersion
	get /versions/:id (PlatformIdReq) returns (PlatformVersionResp)

	@handler ListPlatformVersions
	get /versions (ListPlatformVersionsReq) returns (PlatformVersionListResp)

	@handler CreatePlatformChannel
	post /channels (CreatePlatformChannelReq) returns (PlatformChannelResp)

	@handler GetPlatformChannel
	get /channels/:id (PlatformIdReq) returns (PlatformChannelResp)

	@handler ListPlatformChannels
	get /channels (ListPlatformChannelsReq) returns (PlatformChannelListResp)

	@handler CreatePlatformSigningConfig
	post /signing-configs (CreatePlatformSigningConfigReq) returns (PlatformSigningConfigResp)

	@handler GetPlatformSigningConfig
	get /signing-configs/:id (PlatformIdReq) returns (PlatformSigningConfigResp)

	@handler ListPlatformSigningConfigs
	get /signing-configs (ListPlatformSigningConfigsReq) returns (PlatformSigningConfigListResp)

	@handler CreatePlatformBrandingProfile
	post /branding-profiles (CreatePlatformBrandingProfileReq) returns (PlatformBrandingProfileResp)

	@handler UpdatePlatformBrandingProfile
	put /branding-profiles/:id (UpdatePlatformBrandingProfileReq) returns (PlatformBrandingProfileResp)

	@handler GetPlatformBrandingProfile
	get /branding-profiles/:id (PlatformIdReq) returns (PlatformBrandingProfileResp)

	@handler ListPlatformBrandingProfiles
	get /branding-profiles (ListPlatformBrandingProfilesReq) returns (PlatformBrandingProfileListResp)

	@handler ChangePlatformBrandingProfileStatus
	post /branding-profiles/:id/status (ChangePlatformBrandingProfileStatusReq) returns (PlatformBrandingProfileResp)

	@handler CreatePlatformBrandingPreflight
	post /branding-profiles/:id/preflight (CreatePlatformBrandingPreflightReq) returns (PlatformBrandingPreflightResp)

	@handler GetPlatformBrandingPreflight
	get /branding-preflights/:id (PlatformIdReq) returns (PlatformBrandingPreflightResp)

	@handler ListPlatformBrandingPreflights
	get /branding-preflights (ListPlatformBrandingPreflightsReq) returns (PlatformBrandingPreflightListResp)

	@handler CreatePlatformWhiteLabelTemplate
	post /white-label/templates (CreatePlatformWhiteLabelTemplateReq) returns (PlatformWhiteLabelTemplateResp)

	@handler UpdatePlatformWhiteLabelTemplate
	put /white-label/templates/:id (UpdatePlatformWhiteLabelTemplateReq) returns (PlatformWhiteLabelTemplateResp)

	@handler CopyPlatformWhiteLabelTemplate
	post /white-label/templates/:id/copy (CopyPlatformWhiteLabelTemplateReq) returns (PlatformWhiteLabelTemplateResp)

	@handler DeletePlatformWhiteLabelTemplate
	delete /white-label/templates/:id (PlatformIdReq) returns (RespBase)

	@handler GetPlatformWhiteLabelTemplate
	get /white-label/templates/:id (PlatformIdReq) returns (PlatformWhiteLabelTemplateResp)

	@handler ListPlatformWhiteLabelTemplates
	get /white-label/templates (ListPlatformWhiteLabelTemplatesReq) returns (PlatformWhiteLabelTemplateListResp)

	@handler CreatePlatformWhiteLabelTemplateRevision
	post /white-label/templates/:id/revisions (CreatePlatformWhiteLabelTemplateRevisionReq) returns (PlatformWhiteLabelTemplateRevisionResp)

	@handler GetPlatformWhiteLabelTemplateRevision
	get /white-label/templates/:id/revisions/:revision (PlatformWhiteLabelTemplateRevisionIdReq) returns (PlatformWhiteLabelTemplateRevisionResp)

	@handler UpdatePlatformWhiteLabelTemplateRevision
	put /white-label/templates/:id/revisions/:revision (UpdatePlatformWhiteLabelTemplateRevisionReq) returns (PlatformWhiteLabelTemplateRevisionResp)

	@handler DeletePlatformWhiteLabelTemplateRevision
	delete /white-label/templates/:id/revisions/:revision (PlatformWhiteLabelTemplateRevisionIdReq) returns (RespBase)

