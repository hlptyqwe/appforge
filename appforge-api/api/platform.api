}

type PlatformWhiteLabelProductResp {
	RespBase
	data PlatformWhiteLabelProduct `json:"data"`
}

type PlatformWhiteLabelProductPreflightResp {
	RespBase
	compatible bool   `json:"compatible"`
	reportJson string `json:"reportJson"`
}

